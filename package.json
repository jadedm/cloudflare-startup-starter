{
  "name": "starter-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "pnpm build && wrangler dev --local-protocol https",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply starter-app-db --local",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.11",
    "hono": "4.13.13",
    "jose": "^6.2.12",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "^7.0.2",
    "undici": "^8.12.2",
    "vite": "8.3.4",
    "wrangler": "4.151.1"
  }
}
